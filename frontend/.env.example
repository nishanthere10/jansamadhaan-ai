# Supabase credentials (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: there is deliberately no VITE_API_URL.
# The app calls the backend with relative `/api/...` paths, and the Vite dev
# server proxies those to http://127.0.0.1:8001 (see `server.proxy` in
# vite.config.ts). In deployment, serve the frontend and the API from the same
# origin, or add an equivalent rewrite/proxy at the edge.
